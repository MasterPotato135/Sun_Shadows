<?xml version="1.0" encoding="utf-8"?>
<!-- main/res/xml/preferences.xml -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:seekbar="http://schemas.moonlight-stream.com/apk/res/seekbar">

    <PreferenceCategory android:title="@string/category_basic_settings"
        android:key="category_basic_settings">
        <ListPreference
            android:key="list_resolution"
            android:title="@string/title_resolution_list"
            android:summary="@string/summary_resolution_list"
            android:entries="@array/resolution_names"
            android:entryValues="@array/resolution_values"
            android:defaultValue="1280x720" />
        <ListPreference
            android:key="list_fps"
            android:title="@string/title_fps_list"
            android:summary="@string/summary_fps_list"
            android:entries="@array/fps_names"
            android:entryValues="@array/fps_values"
            android:defaultValue="60" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_bitrate_kbps"
            android:dialogMessage="@string/summary_seekbar_bitrate"
            seekbar:min="500"
            android:max="150000"
            seekbar:step="500"
            seekbar:keyStep="1000"
            seekbar:divisor="1000"
            android:summary="@string/summary_seekbar_bitrate"
            android:text="@string/suffix_seekbar_bitrate_mbps"
            android:title="@string/title_seekbar_bitrate" />
        <ListPreference
            android:key="frame_pacing"
            android:title="@string/title_frame_pacing"
            android:entries="@array/video_frame_pacing_names"
            android:entryValues="@array/video_frame_pacing_values"
            android:summary="@string/summary_frame_pacing"
            android:defaultValue="balanced" />
        <CheckBoxPreference
            android:key="checkbox_stretch_video"
            android:title="@string/title_checkbox_stretch_video"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_mobile_network_settings"
        android:key="category_mobile_network_settings">
        <CheckBoxPreference
            android:key="checkbox_mobile_network_optimizations"
            android:title="@string/title_checkbox_mobile_network_optimizations"
            android:summary="@string/summary_checkbox_mobile_network_optimizations"
            android:defaultValue="false" />
        <ListPreference
            android:key="list_jump_frame_mode"
            android:title="@string/title_jump_frame_mode"
            android:summary="@string/summary_jump_frame_mode"
            android:entries="@array/jump_frame_names"
            android:entryValues="@array/jump_frame_values"
            android:defaultValue="0" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_target_latency"
            android:defaultValue="80"
            android:max="200"
            seekbar:min="20"
            seekbar:step="5"
            android:summary="@string/summary_seekbar_target_latency"
            android:text="@string/suffix_seekbar_target_latency"
            android:title="@string/title_seekbar_target_latency"/>
        <CheckBoxPreference
            android:key="checkbox_adaptive_resolution"
            android:title="@string/title_checkbox_adaptive_resolution"
            android:summary="@string/summary_checkbox_adaptive_resolution"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_bitrate_optimization"
            android:title="@string/title_checkbox_bitrate_optimization"
            android:summary="@string/summary_checkbox_bitrate_optimization"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_bitrate_analysis_interval"
            android:dependency="checkbox_bitrate_optimization"
            android:defaultValue="50"
            android:max="200"
            seekbar:min="10"
            seekbar:step="5"
            android:summary="@string/summary_seekbar_bitrate_analysis_interval"
            android:text="@string/suffix_seekbar_target_latency"
            android:title="@string/title_seekbar_bitrate_analysis_interval"/>
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_frame_similarity_threshold"
            android:dependency="checkbox_bitrate_optimization"
            android:defaultValue="85"
            android:max="100"
            seekbar:min="50"
            seekbar:step="5"
            android:summary="@string/summary_seekbar_frame_similarity_threshold"
            android:text="@string/suffix_seekbar_frame_similarity_threshold"
            android:title="@string/title_seekbar_frame_similarity_threshold"/>
        <CheckBoxPreference
            android:key="checkbox_local_upscaling"
            android:title="@string/title_checkbox_local_upscaling"
            android:summary="@string/summary_checkbox_local_upscaling"
            android:defaultValue="false" />
        <ListPreference
            android:key="list_local_upscaling_mode"
            android:dependency="checkbox_local_upscaling"
            android:title="@string/title_list_local_upscaling_mode"
            android:summary="@string/summary_list_local_upscaling_mode"
            android:entries="@array/local_upscaling_names"
            android:entryValues="@array/local_upscaling_values"
            android:defaultValue="1" />
        <CheckBoxPreference
            android:key="checkbox_prefer_audio_over_video"
            android:title="@string/title_checkbox_prefer_audio_over_video"
            android:summary="@string/summary_checkbox_prefer_audio_over_video"
            android:defaultValue="false" />
        <ListPreference
            android:key="list_transition_frame_mode"
            android:title="@string/title_list_transition_frame_mode"
            android:summary="@string/summary_list_transition_frame_mode"
            android:entries="@array/transition_frame_names"
            android:entryValues="@array/transition_frame_values"
            android:defaultValue="0" />
        <!-- Tipo de curva de interpolação — só visível quando transição está ligada -->
        <ListPreference
            android:key="list_transition_interpolation_type"
            android:title="@string/title_list_transition_interpolation_type"
            android:summary="@string/summary_list_transition_interpolation_type"
            android:entries="@array/transition_interpolation_names"
            android:entryValues="@array/transition_interpolation_values"
            android:defaultValue="1" />
        <!-- Força/intensidade do blend (0–100%) -->
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_transition_strength"
            android:title="@string/title_seekbar_transition_strength"
            android:summary="@string/summary_seekbar_transition_strength"
            android:text="@string/suffix_seekbar_transition_strength"
            android:defaultValue="50"
            android:max="100"
            seekbar:min="0"
            seekbar:step="5" />
        <!-- Frequência mínima de interpolação (1–100 ms) -->
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_transition_frequency_ms"
            android:title="@string/title_seekbar_transition_frequency_ms"
            android:summary="@string/summary_seekbar_transition_frequency_ms"
            android:text="@string/suffix_seekbar_transition_frequency_ms"
            android:defaultValue="16"
            android:max="100"
            seekbar:min="1"
            seekbar:step="1" />
        <CheckBoxPreference
            android:key="checkbox_local_frame_deduplication"
            android:title="@string/title_checkbox_local_frame_deduplication"
            android:summary="@string/summary_checkbox_local_frame_deduplication"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_local_motion_smoothing"
            android:title="@string/title_checkbox_local_motion_smoothing"
            android:summary="@string/summary_checkbox_local_motion_smoothing"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_auto_reconnect"
            android:title="@string/title_checkbox_auto_reconnect"
            android:summary="@string/summary_checkbox_auto_reconnect"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_auto_reconnect_attempts"
            android:dependency="checkbox_auto_reconnect"
            android:defaultValue="3"
            android:max="5"
            seekbar:min="1"
            seekbar:step="1"
            android:summary="@string/summary_seekbar_auto_reconnect_attempts"
            android:text="@string/suffix_seekbar_auto_reconnect_attempts"
            android:title="@string/title_seekbar_auto_reconnect_attempts"/>

        <!-- ===== 20 NOVAS CONFIGURAÇÕES DE 4G (strings inline, sem novas dependências) ===== -->
        <CheckBoxPreference
            android:key="checkbox_4g_packet_loss_recovery"
            android:title="Recuperação de Perda de Pacotes 4G"
            android:summary="Ativa recuperação automática em caso de perda de pacotes"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_buffer_size"
            android:title="Tamanho de Buffer 4G (KB)"
            android:defaultValue="256"
            android:max="1024"
            seekbar:min="64"
            seekbar:step="32"
            android:summary="Aumentar para melhor estabilidade em conexões ruins"
            android:text="KB"/>
        <CheckBoxPreference
            android:key="checkbox_4g_dynamic_bitrate"
            android:title="Taxa de Bits Dinâmica 4G"
            android:summary="Ajusta automaticamente a qualidade da stream"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_jitter_correction"
            android:title="Correção de Jitter (0=Nenhum, 4=Agressivo)"
            android:defaultValue="3"
            android:max="4"
            seekbar:min="0"
            seekbar:step="1"
            android:summary="Reduz efeitos de latência variável"
            android:text="nível"/>
        <CheckBoxPreference
            android:key="checkbox_4g_fec_enabled"
            android:title="Ativar Correção de Erros (FEC)"
            android:summary="Adiciona redundância para recuperar pacotes perdidos"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_max_latency"
            android:title="Latência Máxima 4G (ms)"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="30"
            seekbar:step="10"
            android:summary="Limite máximo aceitável de latência"
            android:text="ms"/>
        <CheckBoxPreference
            android:key="checkbox_4g_bitrate_smoothing"
            android:title="Suavização de Taxa de Bits"
            android:summary="Reduz flutuações abruptas de qualidade"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_network_priority"
            android:title="Prioridade de Rede (0=Baixa, 4=Crítica)"
            android:defaultValue="2"
            android:max="4"
            seekbar:min="0"
            seekbar:step="1"
            android:summary="Define prioridade do tráfego de streaming"
            android:text="nível"/>
        <CheckBoxPreference
            android:key="checkbox_4g_signal_monitoring"
            android:title="Monitoramento de Sinal"
            android:summary="Monitora qualidade do sinal 4G em tempo real"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_frame_drop_threshold"
            android:title="Limite de Queda de Quadros (%)"
            android:defaultValue="5"
            android:max="20"
            seekbar:min="1"
            seekbar:step="1"
            android:summary="Percentual de quadros perdidos antes de adaptação"
            android:text="%"/>
        <CheckBoxPreference
            android:key="checkbox_4g_quality_adaptation"
            android:title="Adaptação de Qualidade 4G"
            android:summary="Reduz qualidade automaticamente em conexões ruins"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_codec_preference"
            android:title="Preferência de Codec (0=Auto, 1=H264, 2=H265, 3=VP9)"
            android:defaultValue="0"
            android:max="3"
            seekbar:min="0"
            seekbar:step="1"
            android:summary="Escolha do codec de vídeo para 4G"
            android:text="codec"/>
        <CheckBoxPreference
            android:key="checkbox_4g_connection_recovery"
            android:title="Recuperação de Conexão 4G"
            android:summary="Tenta reconectar automaticamente em caso de queda"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_recovery_timeout"
            android:title="Timeout de Recuperação (s)"
            android:defaultValue="5"
            android:max="30"
            seekbar:min="1"
            seekbar:step="1"
            android:summary="Tempo máximo para tentar reconectar"
            android:text="s"/>
        <CheckBoxPreference
            android:key="checkbox_4g_packet_prioritization"
            android:title="Priorização de Pacotes"
            android:summary="Prioriza pacotes críticos em caso de congestionamento"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_congestion_control"
            android:title="Controle de Congestionamento (0=Nenhum, 4=Agressivo)"
            android:defaultValue="3"
            android:max="4"
            seekbar:min="0"
            seekbar:step="1"
            android:summary="Estratégia para lidar com congestionamento de rede"
            android:text="nível"/>
        <CheckBoxPreference
            android:key="checkbox_4g_error_correction"
            android:title="Correção de Erros Avançada"
            android:summary="Usa algoritmos avançados para recuperar dados"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_min_bandwidth"
            android:title="Largura de Banda Mínima (kbps)"
            android:defaultValue="2000"
            android:max="50000"
            seekbar:min="500"
            seekbar:step="500"
            android:summary="Largura de banda mínima para manter streaming"
            android:text="kbps"/>
        <CheckBoxPreference
            android:key="checkbox_4g_handover_smooth"
            android:title="Handover Suave entre Redes"
            android:summary="Mantém stream ativo ao mudar entre 4G/Wi-Fi"
            android:defaultValue="true" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_4g_stream_profile"
            android:title="Perfil de Stream (0=Estável, 3=Extremo)"
            android:defaultValue="0"
            android:max="3"
            seekbar:min="0"
            seekbar:step="1"
            android:summary="Presets otimizados para diferentes cenários de rede"
            android:text="perfil"/>
        <!-- ===== FIM DAS 20 NOVAS CONFIGURAÇÕES DE 4G ===== -->
    </PreferenceCategory>

    <!-- main/res/xml/preferences.xml (Deduplicação de áreas) -->
    <PreferenceCategory android:title="@string/category_area_deduplication"
        android:key="category_area_deduplication">
        <CheckBoxPreference
            android:key="checkbox_area_deduplication"
            android:title="@string/title_checkbox_area_deduplication"
            android:summary="@string/summary_checkbox_area_deduplication"
            android:defaultValue="false" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_area_dedup_check_interval"
            android:dependency="checkbox_area_deduplication"
            android:defaultValue="10"
            android:max="60"
            seekbar:min="2"
            seekbar:step="1"
            android:summary="@string/summary_seekbar_area_dedup_check_interval"
            android:text="@string/suffix_seekbar_area_dedup_frames"
            android:title="@string/title_seekbar_area_dedup_check_interval"/>
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_area_dedup_lookback_frames"
            android:dependency="checkbox_area_deduplication"
            android:defaultValue="5"
            android:max="30"
            seekbar:min="2"
            seekbar:step="1"
            android:summary="@string/summary_seekbar_area_dedup_lookback_frames"
            android:text="@string/suffix_seekbar_area_dedup_frames"
            android:title="@string/title_seekbar_area_dedup_lookback_frames"/>
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_area_dedup_replace_frames"
            android:dependency="checkbox_area_deduplication"
            android:defaultValue="3"
            android:max="20"
            seekbar:min="1"
            seekbar:step="1"
            android:summary="@string/summary_seekbar_area_dedup_replace_frames"
            android:text="@string/suffix_seekbar_area_dedup_frames"
            android:title="@string/title_seekbar_area_dedup_replace_frames"/>
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_area_dedup_similarity_threshold"
            android:dependency="checkbox_area_deduplication"
            android:defaultValue="90"
            android:max="100"
            seekbar:min="50"
            seekbar:step="5"
            android:summary="@string/summary_seekbar_area_dedup_similarity_threshold"
            android:text="@string/suffix_seekbar_area_dedup_percent"
            android:title="@string/title_seekbar_area_dedup_similarity_threshold"/>
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_area_dedup_grid_size"
            android:dependency="checkbox_area_deduplication"
            android:defaultValue="8"
            android:max="32"
            seekbar:min="2"
            seekbar:step="1"
            android:summary="@string/summary_seekbar_area_dedup_grid_size"
            android:text="@string/suffix_seekbar_area_dedup_areas"
            android:title="@string/title_seekbar_area_dedup_grid_size"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_audio_settings">
        <ListPreference
            android:key="list_audio_config"
            android:title="@string/title_audio_config_list"
            android:summary="@string/summary_audio_config_list"
            android:entries="@array/audio_config_names"
            android:entryValues="@array/audio_config_values"
            android:defaultValue="2" />
        <CheckBoxPreference
            android:key="checkbox_enable_audiofx"
            android:title="@string/title_checkbox_enable_audiofx"
            android:summary="@string/summary_checkbox_enable_audiofx"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_gamepad_settings"
        android:key="category_gamepad_settings">
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_deadzone"
            android:defaultValue="7"
            android:max="20"
            android:summary="@string/summary_seekbar_deadzone"
            android:text="@string/suffix_seekbar_deadzone"
            android:title="@string/title_seekbar_deadzone"/>
        <CheckBoxPreference
            android:key="checkbox_multi_controller"
            android:title="@string/title_checkbox_multi_controller"
            android:summary="@string/summary_checkbox_multi_controller"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_usb_driver"
            android:title="@string/title_checkbox_xb1_driver"
            android:summary="@string/summary_checkbox_xb1_driver"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_usb_bind_all"
            android:dependency="checkbox_usb_driver"
            android:title="@string/title_checkbox_usb_bind_all"
            android:summary="@string/summary_checkbox_usb_bind_all"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_mouse_emulation"
            android:title="@string/title_checkbox_mouse_emulation"
            android:summary="@string/summary_checkbox_mouse_emulation"
            android:defaultValue="true" />
        <ListPreference
            android:key="analog_scrolling"
            android:dependency="checkbox_mouse_emulation"
            android:title="@string/title_analog_scrolling"
            android:summary="@string/summary_analog_scrolling"
            android:entries="@array/analog_scrolling_names"
            android:entryValues="@array/analog_scrolling_values"
            android:defaultValue="right" />
        <CheckBoxPreference
            android:key="checkbox_vibrate_fallback"
            android:title="@string/title_checkbox_vibrate_fallback"
            android:summary="@string/summary_checkbox_vibrate_fallback"
            android:defaultValue="false" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_vibrate_fallback_strength"
            android:dependency="checkbox_vibrate_fallback"
            android:defaultValue="100"
            android:max="200"
            android:summary="@string/summary_seekbar_vibrate_fallback_strength"
            android:text="@string/suffix_seekbar_vibrate_fallback_strength"
            android:title="@string/title_seekbar_vibrate_fallback_strength"/>
        <CheckBoxPreference
            android:key="checkbox_flip_face_buttons"
            android:title="@string/title_checkbox_flip_face_buttons"
            android:summary="@string/summary_checkbox_flip_face_buttons"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_gamepad_touchpad_as_mouse"
            android:title="@string/title_checkbox_gamepad_touchpad_as_mouse"
            android:summary="@string/summary_checkbox_gamepad_touchpad_as_mouse"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_gamepad_motion_sensors"
            android:title="@string/title_checkbox_gamepad_motion_sensors"
            android:summary="@string/summary_checkbox_gamepad_motion_sensors"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_gamepad_motion_fallback"
            android:title="@string/title_checkbox_gamepad_motion_fallback"
            android:summary="@string/summary_checkbox_gamepad_motion_fallback"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_input_settings"
        android:key="category_input_settings">
        <CheckBoxPreference
            android:key="checkbox_touchscreen_trackpad"
            android:title="@string/title_checkbox_touchscreen_trackpad"
            android:summary="@string/summary_checkbox_touchscreen_trackpad"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_mouse_nav_buttons"
            android:title="@string/title_checkbox_mouse_nav_buttons"
            android:summary="@string/summary_checkbox_mouse_nav_buttons"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_absolute_mouse_mode"
            android:title="@string/title_checkbox_absolute_mouse_mode"
            android:summary="@string/summary_checkbox_absolute_mouse_mode"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_on_screen_controls_settings"
        android:key="category_onscreen_controls">
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="checkbox_show_onscreen_controls"
            android:summary="@string/summary_checkbox_show_onscreen_controls"
            android:title="@string/title_checkbox_show_onscreen_controls" />
        <CheckBoxPreference
            android:key="checkbox_vibrate_osc"
            android:dependency="checkbox_show_onscreen_controls"
            android:title="@string/title_checkbox_vibrate_osc"
            android:summary="@string/summary_checkbox_vibrate_osc"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:dependency="checkbox_show_onscreen_controls"
            android:key="checkbox_only_show_L3R3"
            android:summary="@string/summary_only_l3r3"
            android:title="@string/title_only_l3r3" />
        <CheckBoxPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:defaultValue="true"
            android:dependency="checkbox_show_onscreen_controls"
            android:key="checkbox_show_guide_button"
            android:summary="@string/summary_show_guide_button"
            android:title="@string/title_show_guide_button" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_osc_opacity"
            android:dependency="checkbox_show_onscreen_controls"
            android:dialogMessage="@string/summary_osc_opacity"
            seekbar:min="0"
            seekbar:step="1"
            android:max="100"
            android:defaultValue="90"
            android:summary="@string/summary_osc_opacity"
            android:text="@string/suffix_osc_opacity"
            android:title="@string/dialog_title_osc_opacity" />
        <com.limelight.preferences.ConfirmDeleteOscPreference
            android:title="@string/title_reset_osc"
            android:summary="@string/summary_reset_osc"
            android:dialogTitle="@string/dialog_title_reset_osc"
            android:dialogMessage="@string/dialog_text_reset_osc"
            android:positiveButtonText="@string/yes"
            android:negativeButtonText="@string/no"
            />

    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_host_settings">
        <CheckBoxPreference
            android:key="checkbox_enable_sops"
            android:title="@string/title_checkbox_enable_sops"
            android:summary="@string/summary_checkbox_enable_sops"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_host_audio"
            android:title="@string/title_checkbox_host_audio"
            android:summary="@string/summary_checkbox_host_audio"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_ui_settings"
        android:key="category_ui_settings">
        <CheckBoxPreference
            android:key="checkbox_enable_pip"
            android:title="@string/title_checkbox_enable_pip"
            android:summary="@string/summary_checkbox_enable_pip"
            android:defaultValue="false" />
        <com.limelight.preferences.LanguagePreference
            android:key="list_languages"
            android:title="@string/title_language_list"
            android:entries="@array/language_names"
            android:entryValues="@array/language_values"
            android:summary="@string/summary_language_list"
            android:defaultValue="default" />
        <com.limelight.preferences.SmallIconCheckboxPreference
            android:key="checkbox_small_icon_mode"
